<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CRUX Jump</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background-color: #0d1117;
    color: #c9d1d9;
    font-family: 'JetBrains Mono', monospace, sans-serif;
    overflow: hidden; /* Отключаем прокрутку */
    touch-action: none; /* Отключаем зум и скролл на телефоне */
  }
  canvas {
    display: block;
    background: linear-gradient(180deg, #0d1117 0%, #161b22 100%);
  }
  /* Интерфейс поверх игры */
  #ui {
    position: absolute;
    top: 20px;
    left: 0;
    width: 100%;
    text-align: center;
    pointer-events: none; /* Чтобы клики проходили сквозь текст */
    z-index: 10;
  }
  #score {
    font-size: 24px;
    font-weight: bold;
    color: #3fb950;
    text-shadow: 0 0 10px rgba(63, 185, 80, 0.5);
  }
  #game-over {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(13, 17, 23, 0.95);
    border: 2px solid #f85149;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    display: none;
    z-index: 20;
    width: 80%;
    max-width: 300px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }
  #game-over h2 { color: #f85149; margin-bottom: 10px; font-size: 20px; }
  #game-over p { color: #8b949e; margin-bottom: 20px; font-size: 14px; }
  #restart-btn {
    background: #238636;
    color: white;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    font-weight: bold;
    width: 100%;
    pointer-events: auto;
  }
</style>
</head>
<body>

<div id="ui">
  <div id="score">0</div>
</div>

<div id="game-over">
  <h2>КРИТИЧЕСКАЯ ОШИБКА</h2>
  <p>Твой исходник упал в бездну. Напиши новый коммит.</p>
  <button id="restart-btn" onclick="startGame()">Пересобрать (Заново)</button>
</div>

<canvas id="gameCanvas"></canvas>

<script>
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('score');
  const gameOverEl = document.getElementById('game-over');

  let width, height;
  let player, platforms, score, gameLoop, isGameOver;

  // Настройки физики
  const GRAVITY = 0.4;
  const JUMP_FORCE = -11;
  const MOVE_SPEED = 6;

  // Обработка нажатий (мышь или палец)
  let touchX = null;

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    if (player) {
      // Если экран меняет размер, возвращаем игрока в кадр
      if(player.x > width) player.x = width - player.w;
    }
  }
  window.addEventListener('resize', resize);
  resize();

  // Инициализация игрока (Тукса)
  class Player {
    constructor() {
      this.w = 40;
      this.h = 40;
      this.x = width / 2 - this.w / 2;
      this.y = height - 150;
      this.vx = 0;
      this.vy = 0;
    }
    
    update() {
      this.vy += GRAVITY;
      this.y += this.vy;

      // Движение влево/вправо за пальцем/мышью
      if (touchX !== null) {
        let targetX = touchX - this.w / 2;
        // Плавное движение к цели
        let diff = targetX - this.x;
        this.x += diff * 0.15; 
      }

      // Телепортация через края экрана (как в классике)
      if (this.x > width) this.x = -this.w;
      if (this.x + this.w < 0) this.x = width;
    }

    draw() {
      // Рисуем синего Тукса с помощью кода
      ctx.save();
      ctx.translate(this.x, this.y);
      
      // Тело (синее)
      ctx.fillStyle = "#0099ff";
      ctx.beginPath();
      ctx.ellipse(this.w/2, this.h/2, this.w/2, this.h/2, 0, 0, Math.PI * 2);
      ctx.fill();

      // Живот (белый)
      ctx.fillStyle = "#ffffff";
      ctx.beginPath();
      ctx.ellipse(this.w/2, this.h/2 + 5, this.w/3, this.h/3.5, 0, 0, Math.PI * 2);
      ctx.fill();

      // Глаза
      ctx.fillStyle = "#000000";
      ctx.beginPath();
      ctx.arc(this.w/2 - 6, this.h/2 - 5, 3, 0, Math.PI * 2);
      ctx.arc(this.w/2 + 6, this.h/2 - 5, 3, 0, Math.PI * 2);
      ctx.fill();

      // Клюв
      ctx.fillStyle = "#ffaa00";
      ctx.beginPath();
      ctx.moveTo(this.w/2 - 8, this.h/2 + 2);
      ctx.lineTo(this.w/2 + 8, this.h/2 + 2);
      ctx.lineTo(this.w/2, this.h/2 + 12);
      ctx.closePath();
      ctx.fill();

      ctx.restore();
    }
  }

  // Платформы (Репозитории)
  class Platform {
    constructor(x, y, w, h) {
      this.x = x;
      this.y = y;
      this.w = w;
      this.h = h;
    }
    draw() {
      // Стиль терминала (зеленые рамки)
      ctx.fillStyle = "#161b22";
      ctx.strokeStyle = "#3fb950";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect(this.x, this.y, this.w, this.h, 4);
      ctx.fill();
      ctx.stroke();

      // Имитация текста внутри платформы
      ctx.fillStyle = "#3fb950";
      ctx.font = "10px monospace";
      ctx.fillText(">_", this.x + 5, this.y + 13);
    }
  }

  function init() {
    player = new Player();
    platforms = [];
    score = 0;
    isGameOver = false;
    scoreEl.innerText = score;
    gameOverEl.style.display = 'none';
    touchX = null;

    // Стартовая платформа под игроком
    platforms.push(new Platform(width / 2 - 35, height - 100, 70, 15));

    // Генерируем платформы выше
    for (let i = 1; i < 10; i++) {
      generatePlatform(height - 100 - (i * 90));
    }
  }

  function generatePlatform(forcedY = null) {
    let w = 70;
    let x = Math.random() * (width - w - 20) + 10; // Отступ от краев
    // Высота: либо заданная, либо случайная над самой высокой платформой
    let y = forcedY;
    if (!y) {
      let highestY = height;
      platforms.forEach(p => { if (p.y < highestY) highestY = p.y; });
      y = highestY - (Math.random() * 40 + 60); // Шаг вверх 60-100px
    }
    platforms.push(new Platform(x, y, w, 15));
  }

  function update() {
    if (isGameOver) return;

    player.update();

    // Прокрутка камеры (когда игрок поднимается выше середины экрана)
    if (player.y < height / 2.5) {
      let diff = height / 2.5 - player.y;
      player.y = height / 2.5;
      
      // Двигаем платформы вниз
      platforms.forEach(p => p.y += diff);
      
      // Начисляем очки
      score += Math.floor(diff);
      scoreEl.innerText = score;
    }

    // Коллизии (столкновение с платформами)
    platforms.forEach(p => {
      // Если игрок падает вниз (vy > 0) и касается платформы
      if (player.vy > 0 && 
          player.x + player.w > p.x && 
          player.x < p.x + p.w && 
          player.y + player.h > p.y && 
          player.y + player.h < p.y + p.h + 10) {
        
        player.vy = JUMP_FORCE;
      }
    });

    // Удаление платформ, ушедших за экран, и генерация новых
    platforms = platforms.filter(p => p.y < height + 50);
    while (platforms.length < 10) {
      generatePlatform();
    }

    // Проверка на проигрыш (падение вниз)
    if (player.y > height) {
      gameOver();
    }
  }

  function draw() {
    ctx.clearRect(0, 0, width, height);
    
    platforms.forEach(p => p.draw());
    player.draw();
  }

  function loop() {
    update();
    draw();
    if (!isGameOver) {
      requestAnimationFrame(loop);
    }
  }

  function gameOver() {
    isGameOver = true;
    gameOverEl.style.display = 'block';
  }

  function startGame() {
    init();
    loop();
  }

  // Управление пальцем/мышью
  function handleMove(e) {
    if (e.touches) {
      touchX = e.touches[0].clientX;
    } else {
      touchX = e.clientX;
    }
  }

  canvas.addEventListener('touchmove', handleMove, { passive: false });
  canvas.addEventListener('touchstart', handleMove, { passive: false });
  canvas.addEventListener('mousemove', handleMove);
  
  canvas.addEventListener('touchend', () => { touchX = null; });
  canvas.addEventListener('mouseup', () => { touchX = null; });

  // Запуск
  startGame();

  // Полифилл для roundRect (чтобы платформы были с закругленными углами)
  CanvasRenderingContext2D.prototype.roundRect = function (x, y, w, h, r) {
    if (w < 2 * r) r = w / 2;
    if (h < 2 * r) r = h / 2;
    this.beginPath();
    this.moveTo(x + r, y);
    this.arcTo(x + w, y, x + w, y + h, r);
    this.arcTo(x + w, y + h, x, y + h, r);
    this.arcTo(x, y + h, x, y, r);
    this.arcTo(x, y, x + w, y, r);
    this.closePath();
    return this;
  };

</script>
</body>
</html>
